# XAICG server configuration.
# On Railway, set these in the service's Variables tab. For local development,
# export them in your shell (the server does not read .env files by itself):
#   set -a; source .env; set +a; npm run dev

# ---- Required in production -------------------------------------------------

NODE_ENV=production

# Postgres connection string. Leave unset locally to use the embedded dev
# database. Any Postgres works:
#   Railway:  add the Postgres plugin, then set this to ${{Postgres.DATABASE_URL}}
#   Supabase: Connect -> Session pooler string (port 5432), plus DATABASE_SSL below
DATABASE_URL=

# Your OpenAI API key. It lives only here, never in the extension.
OPENAI_API_KEY=

# Which model writes the drafts. Use OpenAI's current small, fast model.
# The server checks at boot that this model exists for your key.
OPENAI_MODEL=gpt-6-luna

# 32+ random characters. Used to hash IP addresses and X account ids before
# they are stored. Generate with:  openssl rand -base64 32
# Changing it later resets trial tracking (licenses are not affected).
APP_SECRET=

# Password for the admin dashboard at /admin (24+ characters).
# Leave unset to disable the admin API and dashboard entirely.
ADMIN_TOKEN=

# ---- Sign in with Google --------------------------------------------------------

# People sign in inside the extension, with Chrome's own Google account prompt.
# From Google Cloud Console: an OAuth client of type "Chrome Extension",
# created for your extension's ID. Put the same client ID in the extension
# with scripts/set-google-client.mjs. There is no secret and no redirect
# address. Leave empty to run without accounts. A development copy of the
# extension with its own ID needs its own client: list both, comma separated.
GOOGLE_CLIENT_ID=

# With Google configured, the free trial requires an account (one trial per
# Google account). Set to false to make signing in optional.
#TRIAL_REQUIRE_SIGN_IN=true

# ---- Recommended once the extension is published -----------------------------

# Only accept API calls from your extension. Comma separated, no trailing slash.
# Find the id at chrome://extensions. Example:
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=

# Where "Get a license" and "Support" buttons point.
BUY_URL=https://xaicg.uniquelabs.org/#pricing
SUPPORT_URL=https://xaicg.uniquelabs.org/support

# ---- Free trial ---------------------------------------------------------------

# Generations each new install gets for free. 0 disables the trial.
TRIAL_GENERATIONS=20
# Total trial generations one network may use per window (default 3x the above).
#TRIAL_IP_LIMIT=60
#TRIAL_IP_WINDOW_DAYS=30
# Refuse trial requests that do not identify a signed-in X account.
#TRIAL_REQUIRE_X_ACCOUNT=false

# ---- Spend protection -----------------------------------------------------------

# Hard ceilings on generations per UTC day, across all users.
#GLOBAL_DAILY_CAP=30000
#TRIAL_GLOBAL_DAILY_CAP=3000

# ---- Plans ------------------------------------------------------------------------

# Override the built-in plans (starter 60/day 1 device, pro 200/day 2 devices,
# agency 600/day 5 devices). One line of JSON:
#PLANS_JSON={"pro":{"label":"Pro","dailyLimit":200,"maxDevices":2}}

# ---- Rate limits (defaults shown) ------------------------------------------------

#RL_IP_PER_MIN=90
#RL_DEVICE_PER_MIN=12
#COOLDOWN_MS=1500
#REGISTER_PER_IP_PER_HOUR=10
#DEVICES_PER_IP_PER_DAY=15
#ACTIVATE_FAILURES_PER_15MIN=8
#ACTIVATIONS_PER_30_DAYS=10
#SIGN_IN_STARTS_PER_10MIN=10
# How often one install may have its token re-issued per day.
#REREGISTRATIONS_PER_DAY=3
# Failed generations the model was already paid for that are still refunded,
# per install and per network, per hour. Beyond this they are charged.
#REFUNDED_FAILURES_PER_HOUR=5

# ---- Advanced ----------------------------------------------------------------------

# Refuse generation from extension versions older than this (for example after
# an X redesign breaks old builds). Users are told to update.
#MIN_CLIENT_VERSION=3.1.2

# Header that carries the caller's real IP. On Railway this defaults to
# X-Real-IP. On any other host it defaults to the socket address: set it to a
# header your platform overwrites (for a list header such as X-Forwarded-For
# the last entry is used). "none" forces the socket address.
#CLIENT_IP_HEADER=x-real-ip
# Time allowed per model call, and for one whole generation including retries.
#OPENAI_TIMEOUT_MS=20000
#OPENAI_TOTAL_TIMEOUT_MS=30000
# Check generated text with OpenAI's free moderation endpoint (default on).
#MODERATION=true
# Cost estimate on the dashboard, USD per 1M tokens, if your model is not in
# the built-in price table.
#PRICE_IN_PER_M=0.10
#PRICE_OUT_PER_M=0.50
# Force a reasoning effort instead of the per-model default.
#OPENAI_REASONING_EFFORT=
# Set to false to skip the model check at boot.
#OPENAI_VERIFY_MODEL=true
# Database TLS. Not needed on Railway's private network.
#   true       encrypt and verify the certificate against public authorities
#   no-verify  encrypt without verifying (works with Supabase out of the box)
# For full verification against a private authority, paste its root
# certificate (PEM, newlines as \n) into DATABASE_SSL_CA instead.
#DATABASE_SSL=
#DATABASE_SSL_CA=
# Connections the server keeps open. Lower it on small database plans.
#DATABASE_POOL_MAX=10
#PORT=8787
#LOG_LEVEL=info
