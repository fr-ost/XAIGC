# XAICG server configuration.
#
# The server only counts: how many installs there are, and how many drafts of
# each kind they wrote (never what the drafts say). Drafts are written on each
# user's own computer by Chrome's built-in AI, so there is no model key here.
#
# On Railway, set these in the service's Variables tab. For local development,
# export them in your shell (the server does not read .env files by itself):
#   set -a; source .env; set +a; npm run dev

# ---- Required in production -------------------------------------------------

NODE_ENV=production

# Postgres connection string. Leave unset locally to use the embedded dev
# database. Any Postgres works:
#   Railway:  add the Postgres plugin, then set this to ${{Postgres.DATABASE_URL}}
#   Supabase: Connect -> Session pooler string (port 5432), plus DATABASE_SSL below
DATABASE_URL=

# 32+ random characters. Keys the network hashes that stop one network
# inflating the counts. Generate with:  openssl rand -base64 32
APP_SECRET=

# Password for the admin dashboard at /admin (24+ characters).
# Leave unset to disable the dashboard entirely.
ADMIN_TOKEN=

# ---- Recommended once the extension is published -----------------------------

# Only accept counts from your extension. Comma separated, no trailing slash.
# Find the id at chrome://extensions. Example:
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=

# ---- Limits (the defaults are fine) -------------------------------------------

# Requests per minute from one network.
#RL_IP_PER_MIN=120
# Draft reports per minute, and per day, from one install. Reports past the
# daily number are accepted but not counted.
#RL_DRAFTS_PER_DEVICE_PER_MIN=30
#DRAFTS_PER_DEVICE_PER_DAY=2000
# New installs per hour and per day from one network.
#REGISTER_PER_IP_PER_HOUR=20
#DEVICES_PER_IP_PER_DAY=30
# How often one install may register again in a day (after losing its token).
#REREGISTRATIONS_PER_DAY=5

# ---- Hosting -------------------------------------------------------------------

# Which header carries the caller's address. On Railway it is x-real-ip and
# set automatically. Elsewhere set the header your platform overwrites, or
# "none" to use the socket address.
#CLIENT_IP_HEADER=x-real-ip
# Database TLS. Not needed on Railway's private network.
#   true       encrypt and verify the certificate against public authorities
#   no-verify  encrypt without verifying (works with Supabase out of the box)
# For full verification against a private authority, paste its root
# certificate (PEM, newlines as \n) into DATABASE_SSL_CA instead.
#DATABASE_SSL=
#DATABASE_SSL_CA=
# Connections the server keeps open. Lower it on small database plans.
#DATABASE_POOL_MAX=10
#PORT=8787
#LOG_LEVEL=info
