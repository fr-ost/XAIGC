{
  "manifest_version": 3,
  "name": "X AI Comment/Reply Generator for Twitter",
  "short_name": "XAICG",
  "version": "3.1.3",
  "description": "AI comments and replies for X (Twitter) in your own voice, plus questions, posts and threads. A product of Unique Labs.",
  "homepage_url": "https://xaicg.uniquelabs.org",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "clipboardWrite",
    "identity"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://aigc.uniquelabs.org/*"
  ],
  "oauth2": {
    "client_id": "202381471175-a18meita7gtrlengtnudeqlk26cakmt4.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "lib/sfx.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "XAICG",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
